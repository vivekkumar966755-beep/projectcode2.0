<%- include('../partials/header', { title: 'Result', active: 'quizzes' }) %>
<main class="page">
    <div class="card" style="text-align:center; max-width:580px; margin:auto; padding:48px 36px;">
        <div class="kicker">
            <span class="kicker-dot"></span>
            <span>Attempt complete</span>
        </div>
        <h2><%= quiz.title %></h2>
        <p class="muted" style="margin-top:4px;">Assessment completed and graded.</p>
        
        <div style="margin:32px auto; padding:28px; background:linear-gradient(135deg, rgba(240,253,250,0.7), rgba(255,255,255,0.85)); border:1px solid rgba(13,148,136,0.2); border-radius:24px; max-width:320px; box-shadow: 0 10px 25px -5px rgba(13,148,136,0.1);">
            <span style="font-size:12px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted);">Final Score</span>
            <h1 style="font-size:56px; margin:10px 0; color:var(--accent);">
                <span><%= score %></span>
                <span style="color:var(--muted); font-size:32px; font-weight:400;">/</span>
                <span style="color:var(--text); font-size:36px;"><%= totalQuestions %></span>
            </h1>
            <p style="margin:0; font-size:13px; font-weight:600; color:var(--ok);">
                <%= Math.round((score / (totalQuestions || 1)) * 100) %>% Accuracy
            </p>
        </div>

        <div class="actions" style="justify-content:center; margin-top:28px;">
            <a class="btn" href="/quizzes">Explore more quizzes &rarr;</a>
            <a class="btn secondary" href="/participant/history">Transcript & history</a>
        </div>
    </div>
</main>
<%- include('../partials/footer') %>
