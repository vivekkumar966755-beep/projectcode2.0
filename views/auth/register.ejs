<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Join · Apex Quiz</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="/css/app.css"/>
</head>
<body class="auth-wrap">
    <div class="auth-card">
        <a href="/" style="display:inline-flex; align-items:center; gap:10px; margin-bottom:24px; color:var(--muted); font-size:13px; font-weight:600;">
            <span class="brand-mark" style="width:28px; height:28px; font-size:11px; border-radius:8px;">AQ</span>
            <span>Apex Quiz</span>
        </a>
        <div class="kicker">
            <span class="kicker-dot"></span>
            <span>Get started</span>
        </div>
        <h2>Create your account</h2>
        <p class="muted">Join as a creator or participant. Admin access is provisioned separately.</p>
        <% if (locals.error) { %>
            <div class="notice error"><%= locals.error %></div>
        <% } %>
        <form action="/register" method="post" class="form-grid" style="margin-top:20px;">
            <div>
                <label for="name">Full name</label>
                <input id="name" type="text" name="name" value="<%= locals.user ? (locals.user.name || '') : '' %>" placeholder="Alex Morgan" required/>
            </div>
            <div>
                <label for="email">Email address</label>
                <input id="email" type="email" name="email" value="<%= locals.user ? (locals.user.email || '') : '' %>" placeholder="alex@company.com" required/>
            </div>
            <div>
                <label for="password">Password (minimum 6 characters)</label>
                <input id="password" type="password" name="password" minlength="6" placeholder="••••••••" required/>
            </div>
            <div>
                <label for="role">Platform role</label>
                <select id="role" name="role" required>
                    <option value="PARTICIPANT" <%= (locals.user && locals.user.role === 'PARTICIPANT') ? 'selected' : '' %>>Participant — take quizzes & view history</option>
                    <option value="CREATOR" <%= (locals.user && locals.user.role === 'CREATOR') ? 'selected' : '' %>>Creator — compose & author assessments</option>
                </select>
            </div>
            <button class="btn" type="submit" style="width:100%; margin-top:8px;">Create account &rarr;</button>
        </form>
        <p class="muted" style="margin-top:24px; text-align:center; font-size:14px;">
            Already registered? <a href="/login" style="font-weight:600;">Sign in</a>
        </p>
    </div>
</body>
</html>
